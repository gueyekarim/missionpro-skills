generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String             @id @default(uuid()) @db.Uuid
  email           String             @unique
  name            String?
  passwordHash    String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  createdCapabilities Capability[]   @relation("CapabilityCreator")
  evidence        Evidence[]
  capabilities    UserCapability[]
  diagnosticSessions DiagnosticSession[]
  sessions        Session[]

  @@map("users")
}

model Capability {
  id                  String                    @id @default(uuid()) @db.Uuid
  code                String                    @unique
  name                String
  description         String
  domain              String?
  capabilityType      String                    @default("professional")
  purpose             String?
  businessOutcome     String?
  sourceIntent        String?
  outcomes            Json?
  knowledgeRequirements Json?
  observableTasks     Json?
  successCriteria     Json?
  context             Json?
  criticality         String?
  targetLevel         Int?
  evidenceRequirements Json?
  version             Int                       @default(1)
  status              String                    @default("active")
  createdById         String?                   @db.Uuid
  createdBy           User?                     @relation("CapabilityCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  skills              CapabilitySkill[]
  learningUnits       CapabilityLearningUnit[]
  assessments         CapabilityAssessment[]
  evidence            Evidence[]
  userCapabilities    UserCapability[]
  diagnosticSessions  DiagnosticSession[]

  @@map("capabilities")
}

model Skill {
  id           String             @id @default(uuid()) @db.Uuid
  code         String             @unique
  name         String
  description  String?
  category     String?
  skillType    String?
  capabilities CapabilitySkill[]

  @@map("skills")
}

model CapabilitySkill {
  capabilityId String     @db.Uuid
  skillId      String     @db.Uuid
  weight       Decimal?   @db.Decimal(5, 2)
  requiredLevel Int?
  capability   Capability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)
  skill        Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([capabilityId, skillId])
  @@map("capability_skills")
}

model MasteryLevel {
  id                 String   @id @default(uuid()) @db.Uuid
  levelNumber        Int      @unique
  name               String   @unique
  description        String
  observableBehaviors Json
  minimumEvidence    Int      @default(0)
  assessmentRules    Json
  createdAt          DateTime @default(now())

  @@map("mastery_levels")
}

model LearningUnit {
  id                 String                    @id @default(uuid()) @db.Uuid
  title              String
  type               String
  objective          String
  difficulty         Int?
  estimatedDuration  Int?
  createdAt          DateTime                  @default(now())
  capabilities       CapabilityLearningUnit[]

  @@map("learning_units")
}

model CapabilityLearningUnit {
  capabilityId   String       @db.Uuid
  learningUnitId String       @db.Uuid
  targetLevel    Int?
  capability     Capability   @relation(fields: [capabilityId], references: [id], onDelete: Cascade)
  learningUnit   LearningUnit @relation(fields: [learningUnitId], references: [id], onDelete: Cascade)

  @@id([capabilityId, learningUnitId])
  @@map("capability_learning_units")
}

model Assessment {
  id           String                 @id @default(uuid()) @db.Uuid
  title        String
  assessmentType String
  rubric       Json
  passingScore Decimal?               @db.Decimal(5, 2)
  createdAt    DateTime               @default(now())
  capabilities CapabilityAssessment[]
  evidence     Evidence[]

  @@map("assessments")
}

model CapabilityAssessment {
  capabilityId  String      @db.Uuid
  assessmentId  String      @db.Uuid
  masteryLevel  Int?
  capability    Capability  @relation(fields: [capabilityId], references: [id], onDelete: Cascade)
  assessment    Assessment  @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@id([capabilityId, assessmentId])
  @@map("capability_assessments")
}

model Evidence {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @db.Uuid
  capabilityId   String       @db.Uuid
  assessmentId   String?      @db.Uuid
  evidenceType   String
  title          String
  description    String?
  artifactUrl    String?
  artifactText   String?
  score          Decimal?      @db.Decimal(5, 2)
  assessorType   String
  assessorId     String?
  aiAssessment   Json?
  humanValidation Json?
  verified       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  capability     Capability   @relation(fields: [capabilityId], references: [id], onDelete: Cascade)
  assessment     Assessment?  @relation(fields: [assessmentId], references: [id], onDelete: SetNull)

  @@index([userId, capabilityId])
  @@map("evidence")
}

model UserCapability {
  userId          String     @db.Uuid
  capabilityId    String     @db.Uuid
  observedLevel   Int?
  targetLevel     Int?
  confidenceScore Decimal?   @db.Decimal(5, 2)
  evidenceCount   Int        @default(0)
  lastAssessedAt  DateTime?
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  capability      Capability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@id([userId, capabilityId])
  @@map("user_capabilities")
}

model DiagnosticSession {
  id                          String     @id @default(uuid()) @db.Uuid
  userId                      String     @db.Uuid
  capabilityId                String     @db.Uuid
  status                      String     @default("completed")
  method                      Json
  responses                   Json
  observedLevel               Int
  targetLevel                 Int
  capabilityGap               Int
  strengths                   Json
  weaknesses                  Json
  missingEvidence             Json
  evidenceSupportingDiagnosis Json
  explanation                 String
  recommendedPriorities       Json
  provenance                 String
  confidenceScore             Decimal?   @db.Decimal(5, 2)
  createdAt                   DateTime   @default(now())
  completedAt                 DateTime?
  user                        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  capability                  Capability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@index([userId, capabilityId, createdAt])
  @@map("diagnostic_sessions")
}

model Agent {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @unique
  role         String
  systemPrompt String
  agentType    String
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("agents")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  userId    String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("sessions")
}