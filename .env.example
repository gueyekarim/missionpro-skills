# PostgreSQL connection used by Prisma. Never expose this as NEXT_PUBLIC_*.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/missionpro_skills?schema=public"

# At least 32 characters in deployed environments.
SESSION_SECRET="replace-with-a-long-random-secret-at-least-32-characters"

# mock is safe for local development and automated tests.
AI_PROVIDER="mock"
AI_MODEL="missionpro-nova-smoke"
# Required only when AI_PROVIDER=openai. Keep it server-side.
# OPENAI_API_KEY=""

# Optional, defaults are safe for local development.
NODE_ENV="development"